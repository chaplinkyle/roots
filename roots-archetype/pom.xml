<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chaplin.roots</groupId>
        <artifactId>roots-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>roots-archetype</artifactId>
    <packaging>maven-archetype</packaging>
    <name>Roots Application Archetype</name>

    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>3.3.1</version>
            </extension>
        </extensions>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-archetype-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId>
                <executions><execution><id>attach-template-sources</id><phase>package</phase>
                    <goals><goal>jar-no-fork</goal></goals>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
                <executions><execution><id>attach-generator-guide</id><phase>package</phase><goals><goal>jar</goal></goals>
                    <configuration><classifier>javadoc</classifier><classesDirectory>src/main/javadoc</classesDirectory></configuration>
                </execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
