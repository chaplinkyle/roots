<?xml version="1.0" encoding="UTF-8"?>
<Server port="-1">
    <Service name="Roots">
        <Connector address="0.0.0.0" port="8080" protocol="org.apache.coyote.http11.Http11NioProtocol"
                   useVirtualThreads="true" connectionTimeout="10000" keepAliveTimeout="15000"
                   maxConnections="2048" acceptCount="128" maxHttpRequestHeaderSize="16384"
                   maxPostSize="1048576" allowTrace="false" />
        <Engine name="Roots" defaultHost="localhost">
            <Host name="localhost" appBase="webapps" unpackWARs="false" autoDeploy="false" deployOnStartup="true" />
        </Engine>
    </Service>
</Server>
