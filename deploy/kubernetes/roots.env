ROOTS_HOST=0.0.0.0
ROOTS_PORT=8080
ROOTS_DEVELOPMENT=false
ROOTS_SECURE_COOKIES=true
ROOTS_SHUTDOWN_TIMEOUT=PT30S
ROOTS_REQUEST_BODY_TEMPORARY_DIRECTORY=/tmp
ROOTS_MAX_LIVE_VIEWS=500
ROOTS_MAX_CONCURRENT_REQUESTS=1000
ROOTS_MAX_SESSIONS=2000
# Replace with the actual source CIDR of proxy pods. Startup fails until configured.
ROOTS_TRUSTED_PROXIES=REPLACE_WITH_PROXY_POD_CIDR
