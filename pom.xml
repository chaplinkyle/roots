<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.chaplin.roots</groupId>
    <artifactId>roots-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Roots</name>
    <description>A server-driven full-stack Java web framework with live components.</description>
    <url>https://github.com/chaplinkyle/roots</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>chaplinkyle</id>
            <name>Roots maintainers</name>
            <url>https://github.com/chaplinkyle/roots</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/chaplinkyle/roots.git</connection>
        <developerConnection>scm:git:https://github.com/chaplinkyle/roots.git</developerConnection>
        <url>https://github.com/chaplinkyle/roots</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>roots-core</module>
        <module>roots-dev</module>
        <module>roots-servlet</module>
        <module>roots-jdbc</module>
        <module>roots-processor</module>
        <module>roots-maven-plugin</module>
        <module>roots-spring</module>
        <module>roots-spring-boot-starter</module>
        <module>roots-archetype</module>
        <module>examples/enterprise</module>
        <module>examples/chat</module>
        <module>examples/automation</module>
        <module>examples/workflow</module>
        <module>examples/kanban</module>
        <module>examples/servlet</module>
        <module>roots-load-tests</module>
        <module>roots-browser-tests</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <roots.build.source>worktree</roots.build.source>
        <junit.version>5.13.4</junit.version>
        <selenium.version>4.47.0</selenium.version>
        <axe.selenium.version>4.12.0</axe.selenium.version>
        <spring.version>7.0.8</spring.version>
        <spring-boot.version>4.1.0</spring-boot.version>
        <jakarta-servlet.version>6.1.0</jakarta-servlet.version>
        <tomcat.version>11.0.24</tomcat.version>
        <h2.version>2.4.240</h2.version>
        <roots.test.excludedGroups>soak,benchmark</roots.test.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-bom</artifactId>
                <version>${selenium.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                    <configuration>
                        <archive><manifestEntries>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Vendor>Roots contributors</Implementation-Vendor>
                            <Build-Source-Id>${roots.build.source}</Build-Source-Id>
                        </manifestEntries></archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration><notimestamp>true</notimestamp></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>3.15.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>roots-soak</id>
            <properties>
                <roots.test.excludedGroups>benchmark</roots.test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>roots-benchmark</id>
            <properties>
                <roots.test.excludedGroups>soak</roots.test.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
